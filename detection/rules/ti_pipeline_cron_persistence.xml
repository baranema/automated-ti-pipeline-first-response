<!-- Cron persistence (T1053.003): a new file dropped into /etc/cron.d/,
     caught by FIM via Wazuh rule 554. -->
<group name="local,ti_pipeline,persistence,">

  <rule id="100510" level="10">
    <if_sid>554</if_sid>
    <field name="file">^/etc/cron.d/</field>
    <description>Cron persistence: new file added to /etc/cron.d/</description>
    <group>persistence,attack.t1053.003,</group>
  </rule>

</group>
