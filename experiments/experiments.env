# Connection settings for the experiment scripts: the one place to set hosts,
# ports, and SSH user. Every script sources this file.

LAB_USER="tipipeline"

# SSH to each VM (external gateway: port + host).
SSH_CONTROLLER="ssh -p <PORT> $LAB_USER@<GATEWAY_IP>"
SSH_ATTACKER="ssh -p <PORT> $LAB_USER@<GATEWAY_IP>"
SSH_WEBSERVER="ssh -p <PORT> $LAB_USER@<GATEWAY_IP>"
SSH_WORKSTATION="ssh -p <PORT> $LAB_USER@<GATEWAY_IP>"

# Internal addresses the scripts pass around.
WEBSERVER_IP="10.1.1.62"     # attack target
ATTACKER_IP="10.1.1.64"      # source of network attacks
LISTENER_IP="10.0.0.116"     # controller / reverse-shell listener
LISTENER_PORT="4444"

INVENTORY="/opt/automated-ti-pipeline/response/inventory.yml"
